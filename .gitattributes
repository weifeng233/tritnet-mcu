# Normalize line endings: LF in the repository and in every checkout. This repo
# is built on Windows, Linux and macOS in CI; a mixed CRLF/LF tree makes `zig fmt
# --check` and the C engines disagree between platforms.
* text=auto eol=lf

# Toolchain and data files that must never be newline-normalized.
*.png  binary
*.jpg  binary
*.bin  binary
*.pth  binary
*.npz  binary
*.safetensors binary

# Vendored upstream trees and checked-in fixtures are not this repository's
# source. Excluding them keeps GitHub's language bar honest (Zig, not C/Python)
# and keeps diffs of vendored code out of the review surface.
reference/**            linguist-vendored
reference/**            linguist-documentation
modeldata/fixtures/**   linguist-vendored
examples/gpt_names/c/microgpt.c  linguist-vendored
